---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleBody from "../../components/ArticleBody.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ShareButton from "../../components/ShareButton.astro";
import { absUrl } from "../../config";
import {
  ELEMENTS,
  CATEGORY_META,
  categoryLabel,
  adjacentElements,
  sameGroupElements,
  sameGroupLabel,
  type Element,
} from "../../lib/elements";
import { buildArticle, elementPageTitle, formatMass } from "../../lib/article";
import { breadcrumbList } from "../../lib/breadcrumbs";

export function getStaticPaths() {
  return ELEMENTS.map((element) => ({
    params: { slug: element.slug },
    props: { element },
  }));
}

interface Props {
  element: Element;
}
const { element } = Astro.props;
const article = buildArticle(element);
// Trailing slash to match Astro's directory-format canonical / og:url output.
// absUrl() keeps the deployment base (/apps/periodic-table/) so this agrees
// with the <link rel="canonical"> BaseLayout derives from Astro.url.pathname.
const canonical = absUrl(`element/${element.slug}/`);
const accent = CATEGORY_META[element.category].cssVar;
const { prev, next } = adjacentElements(element.number);
const groupMates = sameGroupElements(element);
const groupLabel = sameGroupLabel(element);

// JSON-LD: a ChemicalSubstance for the element itself + a BreadcrumbList.
const chemical = {
  "@context": "https://schema.org",
  "@type": "ChemicalSubstance",
  name: element.name,
  alternateName: element.symbol,
  identifier: String(element.number),
  description: article.metaDescription,
  url: canonical,
  ...(element.discoveredBy && element.discoveredBy !== "Ancient"
    ? { discoverer: { "@type": "Person", name: element.discoveredBy } }
    : {}),
};

const breadcrumbs = breadcrumbList([
  { name: "Home", url: absUrl() },
  { name: "Elements", url: absUrl("elements/") },
  { name: element.name, url: canonical },
]);

// Deep link into /compare/ preloaded with this element and its neighbours,
// so "how does it stack up?" is one click from every article.
const compareIds = [prev, element, next]
  .filter(Boolean)
  .map((e) => e!.slug)
  .join(",");
---

<BaseLayout
  title={elementPageTitle(element)}
  description={article.metaDescription}
  jsonLd={[chemical, breadcrumbs]}
  ogImagePath={`/og/${element.slug}.png`}
  ogImageAlt={`${element.name} (${element.symbol}), element ${element.number}: periodic table tile with key facts`}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { name: "Home", href: "/" },
        { name: "Elements", href: "/elements/" },
        { name: element.name },
      ]}
    />

    <div class="element-hero">
      <div class="element-tile" style={`--tile-accent:var(${accent});`}>
        <span class="num">{element.number}</span>
        <span class="sym">{element.symbol}</span>
        <span class="mass">{formatMass(element)}</span>
      </div>
      <div class="meta">
        <h1>{element.name}</h1>
        <p class="cat">
          {categoryLabel(element.category)} · Group {
            element.group ?? "f-block"
          } · Period {element.period}
        </p>
      </div>
    </div>

    {/* Toolbar: Share + "Show more" affordance kept on the right via margin-left:auto. */}
    <div class="toolbar">
      <ShareButton element={element} />
      <a class="icon-btn" href={`/compare/?ids=${compareIds}`}>
        Compare with neighbours
      </a>
      <a class="icon-btn" href={`/study/#/element/${element.slug}`}>Explore shells &amp; orbitals</a>
      <a class="icon-btn" href={`/study/#/practice?element=${element.slug}`}>Quiz on {element.name}</a>
      <a class="icon-btn" href="/" style="margin-left:auto;">← Back to table</a>
    </div>

    <ArticleBody element={element} />
    {
      ["oxygen", "sulfur"].includes(element.slug) && (
        <p>
          <a href="/oxygen-and-sulfur/">Why do oxygen and sulfur have similar properties?</a>
        </p>
      )
    }

    <nav class="related-elements" aria-label={groupLabel}>
      <h2>{groupLabel}</h2>
      <ul>
        {
          groupMates.map((mate) => (
            <li>
              <a href={`/element/${mate.slug}/`}>
                {mate.name} ({mate.symbol})
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="prevnext" aria-label="Element navigation">
      {
        prev ? (
          <a class="icon-btn" href={`/element/${prev.slug}/`}>
            ← {prev.number} {prev.name}
          </a>
        ) : (
          <span></span>
        )
      }
      {
        next ? (
          <a class="icon-btn" href={`/element/${next.slug}/`}>
            {next.number} {next.name} →
          </a>
        ) : (
          <span></span>
        )
      }
    </nav>
  </div>

  <div class="toast js-toast" role="status" aria-live="polite"></div>
</BaseLayout>

<script>
  import { wireStandaloneShareButtons } from "../../scripts/table-ui";
  const toast = document.querySelector<HTMLElement>(".js-toast");
  let t: ReturnType<typeof setTimeout> | undefined;
  wireStandaloneShareButtons((msg) => {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add("show");
    clearTimeout(t);
    t = setTimeout(() => toast.classList.remove("show"), 2600);
  });
</script>
