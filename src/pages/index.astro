---
import BaseLayout from "../layouts/BaseLayout.astro";
import PeriodicTable from "../components/PeriodicTable.astro";
import ArgonVideo from "../components/ArgonVideo.astro";
import { SITE, absUrl } from "../config";
import { ELEMENTS, CATEGORY_META, type Category } from "../lib/elements";

const cats = Object.entries(CATEGORY_META) as [
  Category,
  (typeof CATEGORY_META)[Category],
][];

// WebSite JSON-LD identifies the site itself; ItemList links out to all 118
// element pages.
const webSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  alternateName: SITE.title,
  description: SITE.description,
  url: absUrl(),
};

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Chemical elements",
  numberOfItems: ELEMENTS.length,
  itemListElement: ELEMENTS.map((el) => ({
    "@type": "ListItem",
    position: el.number,
    url: absUrl(`element/${el.slug}/`),
    name: el.name,
  })),
};
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  jsonLd={[webSite, itemList]}
  referrerPolicy="no-referrer"
>
  <div class="container">
    <div class="hero-copy">
      <h1>Understand the elements. Then test yourself.</h1>
      <p>
        Explore all 118 chemical elements, see their electron shells and orbitals,
        compare their properties, and practise what you learn. Keep your study
        deck, notes and quiz progress on your own device. No account required.
      </p>
      <div class="study-actions" aria-label="Explore the study lab">
        <a class="icon-btn study-primary" href="/study/#/practice?focus=trends&count=5" data-umami-event="practice-open">Start a five-question quiz →</a>
        <a class="icon-btn" href="/study/#/?element=oxygen">Explore an atom</a>
        <a class="icon-btn" href="/study/#/compare?ids=iron,gold,oxygen">Compare elements</a>
      </div>
    </div>

    <section class="study-features" aria-label="Ways to learn chemistry">
      <a href="/study/#/?element=oxygen"><strong>See atomic structure</strong><span>Switch between simplified electron shells and subshell orbitals.</span></a>
      <a href="/study/#/practice"><strong>Learn through practice</strong><span>Get answer explanations, review missed elements and print worksheets.</span></a>
      <a href="/study/#/saved"><strong>Build your study deck</strong><span>Save elements and notes, then export a backup of your progress.</span></a>
    </section>

    <ArgonVideo />

    <h2 class="reference-heading">Look up any element</h2>

    <div class="search-box">
      <label for="pt-search" class="visually-hidden">Filter elements</label>
      <input
        id="pt-search"
        type="search"
        placeholder="Filter by name, symbol, number, or category…"
        autocomplete="off"
      />
      {/* Filter feedback: match count while filtering, empty state on zero. */}
      <p class="search-status js-search-status" role="status" aria-live="polite"></p>
    </div>

    <PeriodicTable />

    <div class="legend" aria-label="Category legend">
      {
        cats.map(([cat, meta]) => (
          <span class="legend-item" data-category={cat}>
            <span
              class="legend-swatch"
              style={`--swatch:var(${meta.cssVar});`}
            />
            {meta.label}
          </span>
        ))
      }
    </div>
  </div>

  {/* ---- More-info slide-in panel ---- */}
  <div class="panel-backdrop js-backdrop"></div>
  {/* `inert` keeps the off-screen panel's controls out of the tab order and
      the accessibility tree until it opens (table-ui.ts toggles it). */}
  <aside
    class="info-panel js-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="panel-title"
    inert
  >
    <div class="panel-head">
      <div class="titles">
        <h2 id="panel-title" class="js-panel-title">Element</h2>
        <span class="sub js-panel-sub"></span>
      </div>
      {/* Controls live on the RIGHT of the header per spec: Share + "Show more" (full page) + Close. */}
      <div class="panel-actions">
        <button class="icon-btn js-panel-share" type="button" aria-label="Share this element">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
          Share
        </button>
        <a class="icon-btn js-panel-more" href="#" aria-label="Open full element page">Show more →</a>
        <button class="icon-btn js-panel-close" type="button" aria-label="Close panel">✕</button>
      </div>
    </div>
    <div class="panel-body js-panel-body">
      <p>Select an element to load its article.</p>
    </div>
  </aside>

  <div class="toast js-toast" role="status" aria-live="polite"></div>
</BaseLayout>

<script>
  import { initInteractiveTable } from "../scripts/table-ui";
  initInteractiveTable();
</script>
