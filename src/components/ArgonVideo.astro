---
const originalPost = "https://x.com/GoogleDeepMind/status/2112557925264752930";
// Public MP4 variant observed in this exact post's X syndication metadata.
const videoSource = "https://video.twimg.com/amplify_video/2112556446218862593/vid/avc1/1280x720/Jg_oHGtDOkoBttrU.mp4";
---

<section class="argon-video" aria-labelledby="argon-video-title" data-argon-video>
  <div class="video-copy">
    <p class="eyebrow">The elements, in motion</p>
    <h2 id="argon-video-title">A periodic table you can see and hear</h2>
    <p>
      Google DeepMind’s demo pairs a 3D periodic table with electron animations
      and light spectra.
    </p>
    <p class="video-credit">
      Video: <a href={originalPost} target="_blank" rel="noopener noreferrer">Google DeepMind on X</a>.
      Built with Gemini 4 Argon in Antigravity. Song: “The Elements” by Tom Lehrer.
    </p>
  </div>

  <figure class="video-figure">
    <div class="video-host" data-video-host>
      <button class="load-video" type="button" data-load-video disabled>
        <svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
          <circle cx="32" cy="32" r="29" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M26 20 45 32 26 44Z" fill="currentColor" />
        </svg>
        <span data-video-label>Play video</span>
        <small>88 seconds · Google DeepMind</small>
      </button>
      <video
        class="argon-player"
        data-video-player
        data-video-source={videoSource}
        aria-label="Google DeepMind’s 3D periodic table video"
        controls
        playsinline
        preload="none"
        tabindex="0"
        hidden
      >
        <p>Your browser cannot play this video. <a href={originalPost}>Watch the original on X</a>.</p>
      </video>
    </div>
    <figcaption>
      <span data-video-status role="status">Play the 88-second video here.</span>
      <a href={originalPost} target="_blank" rel="noopener noreferrer">Watch the original on X ↗</a>
    </figcaption>
  </figure>
</section>

<script>
  import { initArgonVideos } from "../scripts/argon-video";
  initArgonVideos();
</script>

<style>
  .argon-video {
    display: grid;
    gap: 2rem;
    align-items: start;
    padding: clamp(1.25rem, 4vw, 3rem);
    border: 1px solid var(--rule, #2a323d);
    border-radius: 1.25rem;
    background: var(--surface, #161b22);
    color: var(--ink, #e9edf2);
  }
  .eyebrow { color: var(--accent, #4f9dff); font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; }
  h2 { margin: .5rem 0 1rem; line-height: 1.15; font-size: clamp(1.6rem, 3vw, 2.4rem); }
  .video-copy > p + p { margin-top: 1rem; }
  .video-credit, figcaption { font-size: .85rem; color: var(--ink-soft, #aeb8c4); }
  a { color: var(--accent, #4f9dff); }
  a:hover { text-decoration: underline; }
  .video-figure { margin: 0; min-width: 0; width: 100%; max-width: 550px; justify-self: center; }
  .video-host { overflow: hidden; border-radius: 12px; background: #080c12; }
  .load-video {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .65rem; width: 100%; aspect-ratio: 16 / 9; border: 0;
    background: radial-gradient(ellipse at 50% 45%, #17314b, #080c12 75%);
    color: #e9edf2; cursor: pointer; font: inherit;
  }
  .load-video:hover { background: radial-gradient(ellipse at 50% 45%, #244a70, #080c12 75%); }
  .load-video:focus-visible { outline: 3px solid var(--accent, #4f9dff); outline-offset: -5px; }
  .load-video small { color: #aeb8c4; }
  .argon-player { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; background: #080c12; }
  .video-host [hidden] { display: none; }
  .load-video.retry-video { aspect-ratio: auto; padding: .75rem; }
  .retry-video svg, .retry-video small { display: none; }
  figcaption { display: grid; gap: .35rem; margin-top: .8rem; }
  @media (min-width: 920px) { .argon-video { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); } }
</style>
