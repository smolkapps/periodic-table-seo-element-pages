---
import type { Element } from "../lib/elements";
import { buildShareData } from "../lib/elements";
import { absUrl } from "../config";

interface Props {
  element: Element;
  /** Visible label; defaults to "Share". */
  label?: string;
}
const { element, label = "Share" } = Astro.props;
// Pass the origin WITH the deployment base so the shared/copied link resolves
// to the canonical subpath (/apps/periodic-table/element/<slug>/), not the
// origin root. absUrl() ends with "/"; buildShareData trims it before appending.
const share = buildShareData(element, absUrl());
---

<button
  class="icon-btn js-share"
  type="button"
  data-share-title={share.title}
  data-share-text={share.text}
  data-share-url={share.url}
  aria-label={`Share ${element.name}`}
>
  <svg
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="18" cy="5" r="3"></circle>
    <circle cx="6" cy="12" r="3"></circle>
    <circle cx="18" cy="19" r="3"></circle>
    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
  </svg>
  {label}
</button>
