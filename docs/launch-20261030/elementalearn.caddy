# Elementa dedicated-domain launch — 2026-10-30
elementalearn.com {
  import cdn_origin_only_20261023
  root * /var/www/elementalearn.com/html
  encode zstd gzip
  header /site.webmanifest Content-Type application/manifest+json
  file_server
  handle_errors {
    rewrite * /404.html
    file_server
  }
}

www.elementalearn.com {
  import cdn_origin_only_20261023
  redir https://elementalearn.com{uri} permanent
}
