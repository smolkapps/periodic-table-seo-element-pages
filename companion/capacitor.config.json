{
  "appId": "com.smolkapps.elementa",
  "appName": "Elementa",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "backgroundColor": "#0b0e14",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}